{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/apps/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app/:slug",
      "destination": "/api/mini-app"
    },
    {
      "source": "/((?!api/|_next/|app/|\\.well-known/|index\\.html|sw\\.js|manifest\\.json|icon-192\\.png|icon-512\\.png|og-default\\.png|favicon\\.ico|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/api/channel-preview"
    }
  ],
  "crons": [
    {
      "path": "/api/daily-reminders",
      "schedule": "0 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
